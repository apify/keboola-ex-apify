{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "title": "Apify extractor config",
    "type": "object",
    "properties": {
        "#token": {
            "id": "/properties/parameters/properties/#token",
            "type": "string",
            "description": "Create an API token for Keboola in [Apify Console](https://console.apify.com/settings/integrations?createApiToken=true&for=Keboola&utm_source=keboola&utm_medium=integrations) and copy it right after creating it — it is shown only once."
        },
        "crawlerId": {
            "id": "/properties/parameters/properties/crawlerId",
            "type": "string"
        },
        "crawlerSettings": {
            "id": "/properties/parameters/properties/crawlerSettings",
            "type": "object"
        },
        "userId": {
            "id": "/properties/parameters/properties/userId",
            "type": "string"
        }
    },
    "required": [
        "userId",
        "#token",
        "crawlerId"
    ]
}
